  <dc:creator>clairewong</dc:creator>
  <dc:description>RapidRedPanda ISBM ClientAdapter is a .NET client library for working with ISBM 2.0 services in Open Industrial Interoperability Ecosystem (OIIE) scenarios. It supports channel management, publication, request/response workflows, synchronous and asynchronous APIs, and MessageContent media type handling.</dc:description>
  <dc:identifier>RapidRedPanda.ISBM.ClientAdapter</dc:identifier>
  <version>2.2.0</version>
  <keywords>ISBM MIMOSA OIIE ISA-95 message-bus integration interoperability industrial messaging client adapter publication request-response service-bus enterprise-integration data-exchange</keywords>
